# Set default behavior to automatically normalize line endings
* text=auto

# Force specific script/batch files to use Windows CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Force shell scripts and code files to use Unix LF line endings
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf

# Lock binary files so Git never tries to convert their line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
